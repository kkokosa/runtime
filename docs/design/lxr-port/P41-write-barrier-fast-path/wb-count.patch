+#include <pthread.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+static uint64_t g_wbc[8] __attribute__((aligned(64)));
+uintptr_t g_wbc_ptr = reinterpret_cast<uintptr_t>(g_wbc);
+static void* WbcWatch(void*)
+{
+    const char* mark = getenv("PROF_MARK");
+    char path[512];
+    uint64_t at_start[8] = {};
+    bool started = false;
+    for (;;)
+    {
+        usleep(500);
+        if (mark == nullptr) continue;
+        struct stat st;
+        if (!started)
+        {
+            snprintf(path, sizeof(path), "%s.start", mark);
+            if (stat(path, &st) == 0) { memcpy(at_start, g_wbc, sizeof(at_start)); started = true; }
+        }
+        else
+        {
+            snprintf(path, sizeof(path), "%s.end", mark);
+            if (stat(path, &st) == 0)
+            {
+                uint64_t e[8]; memcpy(e, g_wbc, sizeof(e));
+                snprintf(path, sizeof(path), "%s.wbcount", mark);
+                FILE* f = fopen(path, "w");
+                fprintf(f, "assign_entries %llu\nchecked_entries %llu\nslow %llu\nnull_new %llu\nslow_old_null %llu\n",
+                    (unsigned long long)(e[0]-at_start[0]), (unsigned long long)(e[1]-at_start[1]), (unsigned long long)(e[2]-at_start[2]),
+                    (unsigned long long)(e[3]-at_start[3]), (unsigned long long)(e[4]-at_start[4]));
+                fclose(f);
+                return nullptr;
+            }
+        }
+    }
+}
+__attribute__((constructor)) static void WbcInit()
+{
+    pthread_t t; pthread_create(&t, nullptr, WbcWatch, nullptr); pthread_detach(t);
+}
+extern "C" void WbcSlowOldNull(void** slot) { if (*slot == nullptr) g_wbc[4]++; }
